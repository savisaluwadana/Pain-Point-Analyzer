# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY_HEX=
POSTGRES_PASSWORD=
WEB_PORT=3000
WEB_URL=http://localhost:3000
COOKIE_SECURE=false

# Reddit registered + approved OAuth application, not a personal password/session cookie.
# See https://developers.reddit.com/app-registration
REDDIT_API_APPROVED=false
REDDIT_RETENTION_DAYS=7
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/auth/reddit/callback
REDDIT_USER_AGENT=web:YOUR_APPROVED_APP_ID:v0.1 (by /u/YOUR_REDDIT_USERNAME)

# Conservative shared Reddit Data API budgets (provider limits take precedence)
REDDIT_REQUESTS_PER_MINUTE=30
REDDIT_USER_REQUESTS_PER_MINUTE=10
